{
  "name": "crimsonshield-vpn",
  "productName": "CrimsonShield VPN",
  "version": "1.3.0",
  "description": "CrimsonShield VPN for Windows",
  "author": "PhantomAsh",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis --x64 -p never"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "net.crimsonshield.vpn",
    "productName": "CrimsonShield VPN",
    "artifactName": "CrimsonShield-VPN-Setup.${ext}",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "config.json",
        "to": "config.json"
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "requireAdministrator",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CrimsonShield VPN",
      "include": "build/installer.nsh"
    },
    "publish": null
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sweetdevilqueenyt-collab/crimsonshield-vpn"
  }
}